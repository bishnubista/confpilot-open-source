# Optional compatibility fallback for legacy /program, /submit, and reviewer URLs.
# Canonical self-hosted URLs are always /events/<event-slug>/<workspace>.
VITE_DEFAULT_EVENT_SLUG=community-conf

# Where this instance's source code can be obtained. ConfPilot is AGPL-3.0-or-later:
# if you MODIFY it and offer it to others over a network, section 13 requires you to
# offer those users your Corresponding Source. Point this at your own published fork.
# Running an unmodified copy needs no change here.
VITE_SOURCE_URL=https://github.com/bishnubista/confpilot-open-source
