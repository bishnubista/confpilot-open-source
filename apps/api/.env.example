# Configuration for the Node host (`pnpm --filter @confpilot/api start:node`).
#
# Cloudflare deployments do not use this file — they read `wrangler.jsonc` and
# `.dev.vars`. This is the equivalent for running the same application on a
# container or a server, and every setting below is read by `src/host/config.ts`.
#
# Copy to `.env` and fill in. Nothing here is a secret by default; the ones that
# are (Turnstile) are marked.

# --- Required. The server refuses to start without these. ---

# Exact browser-visible origin. Set the HTTPS origin of the reverse proxy in a
# deployed instance; do not set this to the proxy-to-container HTTP hop.
PUBLIC_ORIGIN=https://confpilot.example.org

# AGPL section 13 Corresponding Source for the exact version being served. A
# modified build must point at its own public source, never the upstream project.
SOURCE_URL=https://git.example.org/operator/confpilot

# SQLite file holding the schema, the message outbox, and rate-limit counters.
# Put it on a volume that survives a container restart.
DATABASE_PATH=/var/lib/confpilot/confpilot.sqlite

# Directory backing private file storage: headshots and presentation versions.
# MUST NOT be inside STATIC_DIRECTORY, and must not be served by anything else
# either. On Cloudflare these objects are unreachable by URL by construction;
# here it depends on where you put them. The server refuses to start if this or
# DATABASE_PATH resolves inside STATIC_DIRECTORY — symlinks included — but it
# cannot see a web server you point at these paths yourself.
FILES_DIRECTORY=/var/lib/confpilot/files

# The built SPA (`apps/web/dist`). Served for every path the API does not claim.
STATIC_DIRECTORY=/srv/confpilot/web

# --- Optional, with safe defaults. ---

# Defaults to 8787.
# PORT=8787

# Defaults to 127.0.0.1, which is deliberate: this server does not terminate TLS,
# so binding every interface would publish an unencrypted app to the network. Set
# 0.0.0.0 only when something in front of it terminates TLS — the container image
# sets it because there the loopback is the container's own.
# HOST=127.0.0.1

# Where migrations live. Defaults to the `migrations` directory beside the bundle.
# MIGRATIONS_DIRECTORY=/srv/confpilot/migrations

# What sits in front of this deployment, deciding which header may be believed
# when attributing a caller for rate limiting: `cloudflare`, `forwarded`, or unset.
# Unset means trust nothing, which over-throttles rather than accepting a forged
# identity — every candidate header is client-settable, and `cf-connecting-ip` is
# only trustworthy because Cloudflare's edge overwrites it. Set `forwarded` ONLY
# if a proxy you control overwrites `x-forwarded-for` rather than appending to it.
# CLIENT_IP_SOURCE=forwarded

# Stable identity for calendar events. Choose once, before the first invite goes
# out: changing it later makes previously-sent invites unrecognisable to clients.
# CALENDAR_UID_DOMAIN=confpilot.example.org

# Turnstile, protecting public submission forms. The secret key IS a secret.
# Missing or incomplete configuration disables public registration with a 503;
# it never bypasses captcha verification. Existing-user sign-in remains usable.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ALLOWED_HOSTNAMES=confpilot.example.org

# Email delivery. The Node host has no mail adapter yet, so delivery stays
# disabled and messages accumulate in the outbox rather than being dropped —
# they send once an adapter exists. These are read but currently inert here.
# EMAIL_DELIVERY_ENABLED=false
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
# EMAIL_DELIVERY_SEND_AFTER=
