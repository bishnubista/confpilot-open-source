# Docker Compose reads this root-level file after you copy it to `.env`.
# Both values are public configuration, not credentials.

# The exact browser-visible origin. Use the TLS origin of your reverse proxy.
PUBLIC_ORIGIN=https://confpilot.example.org

# AGPL Corresponding Source for the exact image being built and served. Compose
# uses this one value for both the SPA footer and the runtime `/llms.txt` offer.
SOURCE_URL=https://git.example.org/operator/confpilot
